            const chipsHtml = [
                `<button type="button" data-tag="__all" class="${chipClass(allActive)}">Tất cả</button>`,
                ...TAG_FILTERS.map(t => `<button type="button" data-tag="${t.id}" class="${chipClass(activeTags.has(t.id))}">${t.label}</button>`)
            ].join('');

            chipsContainer.innerHTML = chipsHtml;

            chipsContainer.querySelectorAll('button[data-tag]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.getAttribute('data-tag');
                    if (!id) return;

                    if (id === '__all') {
                        activeTags.clear();
                    } else {
                        if (activeTags.has(id)) activeTags.delete(id);
                        else activeTags.add(id);
                    }

                    renderFilters();
                    renderServices();
                });
            });
        }

