            { id: 'nhanh', label: 'Nhanh', keywords: ['nhanh', 'về nhanh', 'xử lý nhanh'] },
            { id: 'tylecao', label: 'Tỷ lệ cao', keywords: ['tỷ lệ', 'tỷ lệ cao'] },
            { id: 'seo', label: 'SEO', keywords: ['seo'] },
        ];

        function parsePriceValue(priceStr) {
            if (!priceStr) return Number.POSITIVE_INFINITY;
            const s = String(priceStr).trim();
            if (/thương\s*lượng|liên\s*hệ/i.test(s)) return Number.POSITIVE_INFINITY;

            // Range like "3 - 5.000.000đ"
            const range = s.match(/(\d+(?:[.,]\d+)?)\s*-\s*(\d[\d.,]*)/);
            if (range) {
                const aRaw = range[1];
                const bRaw = range[2];
                let a = parseInt(aRaw.replace(/[.,\s]/g, ''), 10);
                let b = parseInt(bRaw.replace(/[.,\s]/g, ''), 10);
                if (Number.isFinite(a) && Number.isFinite(b) && a < 1000 && b >= 1000000) a = a * 1000000;
                return Number.isFinite(a) ? a : Number.POSITIVE_INFINITY;
            }

            const m = s.match(/(\d[\d.,]*)/);
            if (!m) return Number.POSITIVE_INFINITY;
            const v = parseInt(m[1].replace(/[.,\s]/g, ''), 10);
            return Number.isFinite(v) ? v : Number.POSITIVE_INFINITY;
        }

        function matchesActiveTags(service) {
            if (!activeTags || activeTags.size === 0) return true;
            const note = String(service.note || '').toLowerCase();
            for (const tagId of activeTags) {
                const tag = TAG_FILTERS.find(t => t.id === tagId);
                if (!tag) continue;
                const hit = tag.keywords.some(k => note.includes(k));
                if (hit) return true; // OR logic
            }
            return false;
        }

        function sortServices(list) {
            const arr = [...list];
            if (sortMode === 'price-asc') {
                arr.sort((a, b) => (parsePriceValue(a.price) - parsePriceValue(b.price)) || (a.__idx - b.__idx));
            } else if (sortMode === 'price-desc') {
                arr.sort((a, b) => (parsePriceValue(b.price) - parsePriceValue(a.price)) || (a.__idx - b.__idx));
            } else if (sortMode === 'name-asc') {
                arr.sort((a, b) => a.name.localeCompare(b.name, 'vi', { sensitivity: 'base' }));
            } else {
                arr.sort((a, b) => a.__idx - b.__idx);
            }
            return arr;
        }

        function renderFilters() {
            if (!chipsContainer) return;

