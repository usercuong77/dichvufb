        // --- FUNCTIONS ---
        

        const TAG_FILTERS = [
            { id: 'bh', label: 'Bảo hành', keywords: ['bh', 'bảo hành'] },
            { id: 'chinhchu', label: 'Chính chủ', keywords: ['chính chủ'] },
