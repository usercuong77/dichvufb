        // --- INITIALIZE ---
        const yearEl = document.getElementById('year');
        if (yearEl) yearEl.textContent = new Date().getFullYear();

        renderTabs();
        renderFilters();
        renderServices();
        lucide.createIcons();

        updateControlsTop();
        window.addEventListener('resize', updateControlsTop);

    </script>
</body>
</html>
